# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# macOS
.DS_Store

# Isaac / profiling
*.etli

# Generated artefacts. The frozen probe sets and run files are the
# experimental record and are tracked deliberately; everything below is
# regenerable output that is not.
fourarm/out/*_frames/
fourarm/out/ex2_capture/
fourarm/out/*.log
fourarm/out/*.txt

# LaTeX build products
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz

# API keys pasted into a local file by the notebook cell 0. Never tracked.
fourarm/env/keys.local.env

# Notebook copies. The .ipynb itself is tracked deliberately, but a .bak and
# JupyterLab's checkpoints are unreviewed duplicates of it sitting beside it,
# and cell 0 is a place keys get pasted.
*.ipynb.bak
.ipynb_checkpoints/

# Stray virtualenvs. Three lived at the repo root (.venv-1, .venv-2 and
# q2precedence, which is a venv despite the name) and carried 824 MB.
.venv*/
q2precedence/

# Result snapshots. Two zips of tables/ were tracked; the live directories
# and git history are the record, and a zip in the tree goes stale silently.
*.zip

# Editor duplicates. A "foo copy.ipynb" beside foo.ipynb is an unreviewed
# fork that drifts -- one of them carried an armed spend gate.
* copy.*
*.orig
